{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mamahjong",
	"compatibility_date": "2026-01-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"limits": {
		"cpu_ms": 300000
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
